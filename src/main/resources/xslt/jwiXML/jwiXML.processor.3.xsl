                          select="                         distinct-values(for $p in $pragmas                         return                             if ($namespaces($p/@pname) = $namespaces.supported) then                                 'Q{' || $namespaces($p/@pname) || '}' || tokenize($p)[1]                             else                                 if (contains($p/@pname, ':')) then                                     'Q{' || $Qnamespaces(substring-before($p/@pname, ':')) || '}' || substring-after($p/@pname, ':')                                 else                                     'Q{}' || $p/@pname)"/>
            <xsl:message>pragmasEQ: {serialize($pragmas)}</xsl:message>
            <xsl:variable name="pragmas"
                          select="distinct-values($pragmas)[. = $pragmas.supported]"/>
            <!--<xsl:variable name="pragmas" select="$pragmas[. = $pragmas.supported]"/>-->
            <xsl:message>pragmas: {$pragmas}</xsl:message>
            <xsl:choose>
               <xsl:when test="exists($pragmas)">
                  <xsl:iterate select="$pragmas.supported[. = $pragmas]">
                     <xsl:param name="source" select="$parsed.xml"/>
                     <xsl:param name="attempts" as="xs:integer" select="5"/>
                     <!--  <xsl:on-completion select="
                                    if ($options?compile) then
                                        ixsl:call($jwiXML, 'compile', [$source, map:put($options, 'pragmas', false())])
                                    else
