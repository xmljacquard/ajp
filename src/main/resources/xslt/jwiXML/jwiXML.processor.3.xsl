      <xsl:sequence select="jwL:preprocessGrammar($grammarSource,$options)"/>
   </xsl:function>
   <xsl:function name="jwL:preprocessGrammar" as="item()" visibility="public">
      <xsl:param name="grammarSource" as="item()"/>
      <xsl:param name="options" as="map(*)"/>
