                          select="($parsed.xml//pragma | $parsed.xml//ppragma)[@pname[not(. eq 'pragma') and not(starts-with(., 'ns:'))]]"/>
            <xsl:message>pragmasOriginal: {serialize($pragmas)}</xsl:message>
