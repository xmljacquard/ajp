                          select="                         if ($grammarSource instance of document-node()) then                             $grammarSource                         else                             jwL:parseGrammar($grammarSource, $options) =&gt; jwL:grammarToXML()"/>
            <xsl:variable name="namespaces"
                          select="                         map:merge($parsed.xml//ppragma[@pname eq 'pragma']/pragma-data ! (let $p := tokenize(.)                         return                             map:entry($p[1], replace($p[2], '&#34;', ''))))"/>
            <!--  <xsl:message>namespaces: {f:serialize($namespaces)}</xsl:message>-->
            <xsl:variable name="Qnamespaces"
                          select="                         map:merge($parsed.xml//ppragma[starts-with(@pname, 'ns:')] !                         map:entry(substring-after(@pname, ':'), replace(pragma-data, '&#34;', '')))"/>
            <!--<xsl:message>Qnamespaces: {f:serialize($Qnamespaces)}</xsl:message>-->
